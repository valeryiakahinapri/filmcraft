# Netlify / Cloudflare Pages header rules (see HOSTING.md). Other hosts: set the same headers.
/*
  X-Content-Type-Options: nosniff

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# Precompressed sibling `.wasm.br` (see HOSTING.md): hosts that pick sibling .br files up
# themselves need no extra rule; this only pins the type/cache for hosts that serve it as a file.
/*.wasm.br
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
