# Netlify / Cloudflare Pages header rules (see HOSTING.md). Other hosts: set the same headers.
/*
  X-Content-Type-Options: nosniff

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# Precompressed sibling `.wasm.br` (see HOSTING.md): hosts that pick sibling .br files up
# automatically (Netlify, Cloudflare Pages with Brotli) need no rule at all — they serve the
# `.wasm` URL with `Content-Encoding: br`. Do NOT serve the `.wasm.br` URL as a plain file with
# `application/wasm`: a client fetching those raw Brotli bytes without `Content-Encoding: br`
# would fail to compile them. Serve it yourself only with both headers set.

/*.js
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
