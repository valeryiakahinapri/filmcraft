# Apache (see HOSTING.md). Needs mod_mime; mod_deflate and mod_headers are optional.
AddType application/wasm .wasm
AddType text/javascript .js

<IfModule mod_deflate.c>
  # Compress on the fly; when you instead serve precompressed `.wasm.br` files (see HOSTING.md),
  # exclude them from this filter so the bytes are not double-encoded.
  AddOutputFilterByType DEFLATE application/wasm text/javascript text/html
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The worklet and the wasm-bindgen/eframe snippet files carry no build hash in their URLs, so
  # they must be revalidated like index.html, not cached immutably. These later rules override
  # the general one above for the same header.
  <FilesMatch "^(audio-worklet\.js|inline[0-9]+\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Precompressed sibling files (see HOSTING.md): same caching as the raw assets.
  <FilesMatch "\.wasm\.br$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
